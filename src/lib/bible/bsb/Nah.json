[{"blocks":[{"kind":"heading","content":["The Burden against Nineveh"]},{"kind":"parallel","content":["(",{"ref":"Jonah.1.1-Jonah.1.3","text":["Jonah 1:1–3"]},")"]},{"kind":"p","content":[{"verse":1},"This is the burden against Nineveh, the book of the vision of Nahum the Elkoshite:"]},{"kind":"line1","content":[{"verse":2},"The LORD is a jealous and avenging God;"],"stanza":true},{"kind":"line2","content":["the LORD is avenging and full of wrath."]},{"kind":"line1","content":["The LORD takes vengeance on His foes"]},{"kind":"line2","content":["and reserves wrath for His enemies."]},{"kind":"line1","content":[{"verse":3},"The LORD is slow to anger"]},{"kind":"line2","content":["and great in power;"]},{"kind":"line1","content":["the LORD will by no means"]},{"kind":"line2","content":["leave the guilty unpunished."]},{"kind":"line1","content":["His path is in the whirlwind and storm,"]},{"kind":"line2","content":["and clouds are the dust beneath His feet."]},{"kind":"line1","content":[{"verse":4},"He rebukes the sea and dries it up;"]},{"kind":"line2","content":["He makes all the rivers run dry."]},{"kind":"line1","content":["Bashan and Carmel wither,"]},{"kind":"line2","content":["and the flower of Lebanon wilts."]},{"kind":"line1","content":[{"verse":5},"The mountains quake before Him,"]},{"kind":"line2","content":["and the hills melt away;"]},{"kind":"line1","content":["the earth trembles at His presence—"]},{"kind":"line2","content":["the world and all its dwellers."]},{"kind":"line1","content":[{"verse":6},"Who can withstand His indignation?"]},{"kind":"line2","content":["Who can endure His burning anger?"]},{"kind":"line1","content":["His wrath is poured out like fire;"]},{"kind":"line2","content":["even rocks are shattered before Him."]},{"kind":"line1","content":[{"verse":7},"The LORD is good,"],"stanza":true},{"kind":"line2","content":["a stronghold in the day of distress;"]},{"kind":"line2","content":["He cares for those who trust in Him."]},{"kind":"line1","content":[{"verse":8},"But with an overwhelming flood"]},{"kind":"line2","content":["He will make an end of Nineveh",{"note":0}]},{"kind":"line2","content":["and pursue His enemies into darkness."]},{"kind":"line1","content":[{"verse":9},"Whatever you plot against the LORD,"],"stanza":true},{"kind":"line2","content":["He will bring to an end."]},{"kind":"line1","content":["Affliction will not rise up"]},{"kind":"line2","content":["a second time."]},{"kind":"line1","content":[{"verse":10},"For they will be entangled as with thorns"]},{"kind":"line2","content":["and consumed like the drink of a drunkard—"]},{"kind":"line2","content":["like stubble that is fully dry."]},{"kind":"line1","content":[{"verse":11},"From you, O Nineveh, comes forth"]},{"kind":"line2","content":["a plotter of evil against the LORD,"]},{"kind":"line2","content":["a counselor of wickedness."]},{"kind":"p","content":[{"verse":12},"This is what the LORD says:"]},{"kind":"line1","content":["“Though they are allied and numerous,"],"stanza":true},{"kind":"line2","content":["yet they will be cut down and pass away."]},{"kind":"line1","content":["Though I have afflicted you, O Judah,"]},{"kind":"line2","content":["I will afflict you no longer."]},{"kind":"line1","content":[{"verse":13},"For I will now break their yoke from your neck"]},{"kind":"line2","content":["and tear away your shackles.”"]},{"kind":"p","content":[{"verse":14},"The LORD has issued a command concerning you, O Nineveh:"]},{"kind":"line1","content":["“There will be no descendants"],"stanza":true},{"kind":"line2","content":["to carry on your name."]},{"kind":"line1","content":["I will cut off the carved image and cast idol"]},{"kind":"line2","content":["from the house of your gods;"]},{"kind":"line1","content":["I will prepare your grave,"]},{"kind":"line2","content":["for you are contemptible.”"]},{"kind":"line1","content":[{"verse":15},"Look to the mountains—"],"stanza":true},{"kind":"line2","content":["the feet of one who brings good news,"]},{"kind":"line2","content":["who proclaims peace!"]},{"kind":"line1","content":["Celebrate your feasts, O Judah;"]},{"kind":"line2","content":["fulfill your vows."]},{"kind":"line1","content":["For the wicked will never again march through you;"]},{"kind":"line2","content":["they will be utterly cut off."]}],"notes":[{"verse":8,"content":["Literally ",{"italic":["of her place"]}]}]},{"blocks":[{"kind":"heading","content":["The Overthrow of Nineveh"]},{"kind":"line1","content":[{"verse":1},"One who scatters advances"],"stanza":true},{"kind":"line2","content":["against you, O Nineveh."]},{"kind":"line1","content":["Guard the fortress!"]},{"kind":"line2","content":["Watch the road!"]},{"kind":"line1","content":["Brace yourselves!",{"note":0}]},{"kind":"line2","content":["Summon all your strength!"]},{"kind":"line1","content":[{"verse":2},"For the LORD will restore the splendor of Jacob"],"stanza":true},{"kind":"line2","content":["like the splendor of Israel,"]},{"kind":"line1","content":["though destroyers have laid them waste"]},{"kind":"line2","content":["and ruined the branches of their vine."]},{"kind":"line1","content":[{"verse":3},"The shields of his mighty men are red;"],"stanza":true},{"kind":"line2","content":["the valiant warriors are dressed in scarlet."]},{"kind":"line1","content":["The fittings of the chariots flash like fire"]},{"kind":"line2","content":["on the day they are prepared,"]},{"kind":"line1","content":["and the spears of cypress"]},{"kind":"line2","content":["have been brandished.",{"note":1}]},{"kind":"line1","content":[{"verse":4},"The chariots dash through the streets;"]},{"kind":"line2","content":["they rush around the plazas,"]},{"kind":"line1","content":["appearing like torches,"]},{"kind":"line2","content":["darting about like lightning."]},{"kind":"line1","content":[{"verse":5},"He summons his nobles;"]},{"kind":"line2","content":["they stumble as they advance."]},{"kind":"line1","content":["They race to its wall;"]},{"kind":"line2","content":["the protective shield is set in place."]},{"kind":"line1","content":[{"verse":6},"The river gates are thrown open"]},{"kind":"line2","content":["and the palace collapses."]},{"kind":"line1","content":[{"verse":7},"It is decreed that the city be exiled"],"stanza":true},{"kind":"line2","content":["and carried away;"]},{"kind":"line1","content":["her maidservants moan like doves,"]},{"kind":"line2","content":["and beat upon their breasts."]},{"kind":"line1","content":[{"verse":8},"Nineveh has been like a pool of water"]},{"kind":"line2","content":["throughout her days,"]},{"kind":"line2","content":["but now it is draining away."]},{"kind":"line1","content":["“Stop! Stop!” they cry,"]},{"kind":"line2","content":["but no one turns back."]},{"kind":"line1","content":[{"verse":9},"“Plunder the silver!"]},{"kind":"line2","content":["Plunder the gold!”"]},{"kind":"line1","content":["There is no end to the treasure,"]},{"kind":"line2","content":["an abundance of every precious thing."]},{"kind":"line1","content":[{"verse":10},"She is emptied!"]},{"kind":"line2","content":["Yes, she is desolate and laid waste!"]},{"kind":"line1","content":["Hearts melt, knees knock,"]},{"kind":"line2","content":["bodies tremble, and every face grows pale!"]},{"kind":"line1","content":[{"verse":11},"Where is the lions’ lair"],"stanza":true},{"kind":"line2","content":["or the feeding ground of the young lions,"]},{"kind":"line1","content":["where the lion and lioness prowled with their cubs,"]},{"kind":"line2","content":["with nothing to frighten them away?"]},{"kind":"line1","content":[{"verse":12},"The lion mauled enough for its cubs"]},{"kind":"line2","content":["and strangled prey for the lioness."]},{"kind":"line1","content":["It filled its dens with the kill,"]},{"kind":"line2","content":["and its lairs with mauled prey."]},{"kind":"line1","content":[{"verse":13},"“Behold, I am against you,”"],"stanza":true},{"kind":"line2","content":["declares the LORD of Hosts."]},{"kind":"line1","content":["“I will send your chariots up in smoke,"]},{"kind":"line2","content":["and the sword will devour your young lions."]},{"kind":"line1","content":["I will cut off your prey from the earth,"]},{"kind":"line2","content":["and the voices of your messengers"]},{"kind":"line2","content":["will no longer be heard.”"]}],"notes":[{"verse":1,"content":["Hebrew ",{"italic":["Strengthen your loins!"]}]},{"verse":3,"content":["Hebrew; alternately, the spears may be of ",{"italic":["pine"]}," or ",{"italic":["juniper"]}," or ",{"italic":["fir"]},"; LXX and Syriac ",{"italic":["they are prepared, and the horsemen rush to and fro."]}]}]},{"blocks":[{"kind":"heading","content":["Judgment on Nineveh"]},{"kind":"line1","content":[{"verse":1},"Woe to the city of blood,"],"stanza":true},{"kind":"line2","content":["full of lies,"]},{"kind":"line1","content":["full of plunder,"]},{"kind":"line2","content":["never without prey."]},{"kind":"line1","content":[{"verse":2},"The crack of the whip,"]},{"kind":"line2","content":["the rumble of the wheel,"]},{"kind":"line1","content":["galloping horse"]},{"kind":"line2","content":["and bounding chariot!"]},{"kind":"line1","content":[{"verse":3},"Charging horseman,"]},{"kind":"line2","content":["flashing sword,"]},{"kind":"line2","content":["shining spear;"]},{"kind":"line1","content":["heaps of slain,"]},{"kind":"line2","content":["mounds of corpses,"]},{"kind":"line1","content":["dead bodies without end—"]},{"kind":"line2","content":["they stumble over their dead—"]},{"kind":"line1","content":[{"verse":4},"because of the many harlotries of the harlot,"]},{"kind":"line2","content":["the seductive mistress of sorcery,"]},{"kind":"line1","content":["who betrays nations by her prostitution"]},{"kind":"line2","content":["and clans by her witchcraft."]},{"kind":"line1","content":[{"verse":5},"“Behold, I am against you,”"],"stanza":true},{"kind":"line2","content":["declares the LORD of Hosts."]},{"kind":"line1","content":["“I will lift your skirts over your face."]},{"kind":"line2","content":["I will show your nakedness to the nations"]},{"kind":"line2","content":["and your shame to the kingdoms."]},{"kind":"line1","content":[{"verse":6},"I will pelt you with filth"]},{"kind":"line2","content":["and treat you with contempt;"]},{"kind":"line2","content":["I will make a spectacle of you."]},{"kind":"line1","content":[{"verse":7},"Then all who see you"]},{"kind":"line2","content":["will recoil from you and say,"]},{"kind":"line1","content":["‘Nineveh is devastated;"]},{"kind":"line2","content":["who will grieve for her?’"]},{"kind":"line1","content":["Where can I find"]},{"kind":"line2","content":["comforters for you?”"]},{"kind":"line1","content":[{"verse":8},"Are you better than Thebes,",{"note":0}],"stanza":true},{"kind":"line2","content":["stationed by the Nile with water around her,"]},{"kind":"line1","content":["whose rampart was the sea,"]},{"kind":"line2","content":["whose wall was the water?"]},{"kind":"line1","content":[{"verse":9},"Cush",{"note":1}," and Egypt were her boundless strength;"]},{"kind":"line2","content":["Put and Libya were her allies."]},{"kind":"line1","content":[{"verse":10},"Yet she became an exile;"]},{"kind":"line2","content":["she went into captivity."]},{"kind":"line1","content":["Her infants were dashed to pieces"]},{"kind":"line2","content":["at the head of every street."]},{"kind":"line1","content":["They cast lots for her dignitaries,"]},{"kind":"line2","content":["and all her nobles were bound in chains."]},{"kind":"line1","content":[{"verse":11},"You too will become drunk;"]},{"kind":"line2","content":["you will go into hiding"]},{"kind":"line2","content":["and seek refuge from the enemy."]},{"kind":"line1","content":[{"verse":12},"All your fortresses are fig trees"],"stanza":true},{"kind":"line2","content":["with the first ripe figs;"]},{"kind":"line1","content":["when shaken, they fall"]},{"kind":"line2","content":["into the mouth of the eater!"]},{"kind":"line1","content":[{"verse":13},"Look at your troops—"],"stanza":true},{"kind":"line2","content":["they are like your women!"]},{"kind":"line1","content":["The gates of your land"]},{"kind":"line2","content":["are wide open to your enemies;"]},{"kind":"line2","content":["fire consumes their bars."]},{"kind":"line1","content":[{"verse":14},"Draw your water for the siege;"],"stanza":true},{"kind":"line2","content":["strengthen your fortresses."]},{"kind":"line1","content":["Work the clay and tread the mortar;"]},{"kind":"line2","content":["repair the brick kiln!"]},{"kind":"line1","content":[{"verse":15},"There the fire will devour you;"]},{"kind":"line2","content":["the sword will cut you down"]},{"kind":"line2","content":["and consume you like a young locust."]},{"kind":"line1","content":["Make yourself many like the young locust;"]},{"kind":"line2","content":["make yourself many like the swarming locust!"]},{"kind":"line1","content":[{"verse":16},"You have multiplied your merchants"]},{"kind":"line2","content":["more than the stars of the sky."]},{"kind":"line1","content":["The young locust strips the land"]},{"kind":"line2","content":["and flies away."]},{"kind":"line1","content":[{"verse":17},"Your guards",{"note":2}," are like the swarming locust,"]},{"kind":"line2","content":["and your scribes",{"note":3}," like clouds of locusts"]},{"kind":"line2","content":["that settle on the walls on a cold day."]},{"kind":"line1","content":["When the sun rises, they fly away,"]},{"kind":"line2","content":["and no one knows where."]},{"kind":"line1","content":[{"verse":18},"O king of Assyria, your shepherds slumber;"],"stanza":true},{"kind":"line2","content":["your officers sleep."]},{"kind":"line1","content":["Your people are scattered on the mountains"]},{"kind":"line2","content":["with no one to gather them."]},{"kind":"line1","content":[{"verse":19},"There is no healing for your injury;"]},{"kind":"line2","content":["your wound is severe."]},{"kind":"line1","content":["All who hear the news of you"]},{"kind":"line2","content":["applaud your downfall,"]},{"kind":"line1","content":["for who has not experienced"]},{"kind":"line2","content":["your constant cruelty?"]}],"notes":[{"verse":8,"content":["Hebrew ",{"italic":["No-amon"]}]},{"verse":9,"content":["That is, the upper Nile region"]},{"verse":17,"content":["Or ",{"italic":["princes"]}]},{"verse":17,"content":["Or ",{"italic":["marshals"]}]}]}]